---
import MainLayout from "../layouts/MainLayout.astro";
import ProjectList from "../components/ProjectList.vue";

//@ts-ignore
import { sanityClient } from "sanity:client";

const allProjects = await sanityClient.fetch(`
  *[_type == "project"] {
  title,
  description,
  image[]{"url": asset->url},
  links,
  type[]
  }
`);

---
<MainLayout title="pedro machado: portfolio" namespace="home">
<!-- <div id="loading-screen" class="fixed inset-0 bg-white z-50 flex items-center justify-center">
  <div class="loader"></div>
</div> -->
  <section class="layout mt-12">
  <p class="animate-text  col-span-4  text-6xl font-title italic" >
    Media artist from Argentina
  </p>
  <img
    src="/face_photo.png"
    alt="a picture of pedro machado"
    class="col-span-2 col-start-5 xl:col-span-1"
  />
  <ul class="col-start-5 overflow-hidden space-y-3 text-black col-span-2 md:col-span-1 md:col-start-5  text-sm p-3">
    <li><a href="https://instagram.com/pdromchado_" target="_blank">@pdromchado_</a></li>
  </ul>

  </section>


  <section class="layout mt-12 ">

    <p class="col-span-4 lg:col-span-3 lg:col-start-2 col-start-2 mb-4 text-xl">
        Film student at <a class="animate-text" href="https://www.ucine.edu.ar/" target="_blank">UCINE (Universided del Cine).</a> Keen for composition, both harmonious and antiesthetic. I know how to do a lot of things with computers; you can see some examples of my works below.
    </p>
    </section>

    <ProjectList projects={allProjects} client:only/>

</MainLayout>
